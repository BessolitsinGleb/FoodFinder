# Скопируйте в .env и заполните. Вложенные настройки — через "__".

# --- Приложение ---
APP__NAME="Food Suppliers API"
APP__ENV=local                 # local | dev | prod
APP__DEBUG=true                # только подробность логов; трейсбеки клиенту не уходят
APP__HOST=127.0.0.1
APP__PORT=8000
APP__API_PREFIX=/api/v1
APP__CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'   # адрес фронтенда

# --- PostgreSQL ---
DB__HOST=localhost
DB__PORT=5432
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=food_suppliers
DB__ECHO=false                 # логировать SQL
DB__POOL_SIZE=5
DB__MAX_OVERFLOW=10
# Или строкой целиком (так её выдаёт Railway) — тогда поля выше не нужны:
# DB__DSN=postgresql://user:pass@host:5432/dbname

# --- LLM (OpenRouter) ---
LLM__API_KEY=sk-or-v1-...      # https://openrouter.ai/keys
LLM__BASE_URL=https://openrouter.ai/api/v1
LLM__MODEL=deepseek/deepseek-v4-flash   # или deepseek/deepseek-v4-pro (умнее, дороже)
LLM__TEMPERATURE=0.3
LLM__MAX_TOKENS=4096
LLM__CHAT_REASONING=true          # "размышления" модели в чате
LLM__JSON_REASONING=false         # в пайплайне поиска и письмах — выключены (быстрее, дешевле, не обрезается)
LLM__TIMEOUT=120
LLM__MAX_RETRIES=2
LLM__MAX_AGENT_STEPS=8
# Необязательно: адрес сайта для статистики OpenRouter (HTTP-Referer).
# Комментарий не пишем в одной строке с пустым значением: Docker Compose считает его значением.
LLM__APP_URL=
LLM__APP_TITLE="Food Suppliers"

# --- Поиск в интернете (Tavily) ---
WEB__API_KEY=tvly-...          # https://app.tavily.com
WEB__SEARCH_DEPTH=basic        # basic = 1 кредит за запрос, advanced = 2
WEB__TIMEOUT=30

# --- Пайплайн поиска поставщиков (баланс качества и стоимости) ---
SEARCH__RESULTS_PER_QUERY=8    # результатов на один поисковый запрос
SEARCH__MIN_CANDIDATES=8       # расширяем географию, пока не наберём столько кандидатов
SEARCH__EXTRA_TO_VERIFY=3      # сколько кандидатов сверх top_k проверять по отзывам/документам
SEARCH__VERIFY_CONCURRENCY=3   # параллельных проверок

# --- Письма ---
LETTERS__DEFAULT_TEMPLATE=default   # файл backend/app/templates/letters/<имя>.txt

# --- Авторизация (JWT) ---
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET_KEY=
AUTH__ACCESS_TOKEN_MINUTES=1440
AUTH__CODE_TTL_MINUTES=10         # срок жизни кода из письма
AUTH__CODE_MAX_ATTEMPTS=5         # после стольких неверных вводов код сгорает
AUTH__RESEND_COOLDOWN_SECONDS=60

# --- Redis (ограничитель запросов и память диалога) ---
REDIS__URL=redis://localhost:6379/0
RATE_LIMIT__REQUESTS=3            # не больше 3 запросов...
RATE_LIMIT__WINDOW_MS=1000        # ...в секунду на пользователя (или IP)
CHAT__HISTORY_MESSAGES=20         # сколько последних сообщений помнит агент
CHAT__HISTORY_TTL_SECONDS=3600    # через час тишины история стирается

# --- SMTP (письма с кодом подтверждения) ---
# smtp — обычный SMTP (VPS, локально); gmail — Gmail API по HTTPS (хостинги с закрытым SMTP,
# например бесплатный Render); brevo — HTTP API Brevo
SMTP__PROVIDER=smtp
# Для gmail: OAuth-клиент (Google Cloud → Credentials → Desktop app), токен пишет scripts/gmail_auth.py
SMTP__GMAIL_CLIENT_ID=
SMTP__GMAIL_CLIENT_SECRET=
SMTP__GMAIL_REFRESH_TOKEN=
SMTP__BREVO_API_KEY=
SMTP__FROM_NAME=FoodFinder
SMTP__HOST=
SMTP__PORT=587                    # 587 + STARTTLS или 465 + SMTP__USE_TLS=true
SMTP__USER=
SMTP__PASSWORD=
SMTP__FROM_ADDRESS=
SMTP__USE_TLS=false
SMTP__DEV_LOG_CODES=false         # только локально: код в лог вместо письма (ввод кода всё равно нужен)
